# Copy this file to .env.local and add local values.
# Never commit real secrets.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# CLI-only values. Keep these out of client code.
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_DB_PASSWORD=your-database-password
SUPABASE_ACCESS_TOKEN=your-personal-access-token

# Server-only integrations. Add real values only when the related feature is enabled.
OPENAI_API_KEY=
OPENAI_FINANCE_MODEL=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_FINANCE_MODEL=
DEEPSEEK_CONTENT_MODEL=
MARKET_DATA_PROVIDER=
MARKET_DATA_BASE_URL=
MARKET_DATA_API_KEY=
MARKET_CACHE_TTL_MINUTES=30

# Server-only AI routing. Model names stay centralized in src/server/ai/config.ts.
AI_PROVIDER=openai
AI_CUSTOM_BASE_URL=
AI_CUSTOM_API_KEY=
AI_CUSTOM_MODEL=
